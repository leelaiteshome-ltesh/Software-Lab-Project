MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app>"
MONGODB_DB_NAME="hardware_checkout"
MONGODB_PROJECTS_DB_NAME="hardware_checkout_projects"
MONGODB_HARDWARE_DB_NAME="hardware_checkout_hardware"

